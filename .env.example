# Cấu hình môi trường — Sao chép file này thành .env rồi điền thông tin thực
# cp .env.example .env

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── PostgreSQL Database ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movie_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── Email SMTP (Gmail + App Password) ──────────────────────────
# Bật "App Password" trong Gmail: myaccount.google.com/apppasswords
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16char_app_password
MAIL_FROM=your_gmail@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# ── App URLs ───────────────────────────────────────────────────
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

# ── TMDB API (Dùng cho script lấy poster) ──────────────────────
# Đăng ký lấy key tại: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
