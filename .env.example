# Cấu hình môi trường — Sao chép file này thành .env rồi điền thông tin thực
# cp .env.example .env

# ── PostgreSQL Database ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movie_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── JWT Secret ─────────────────────────────────────────────────
JWT_SECRET_KEY=your_secret_key_here_minimum_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Email (Gmail SMTP) ─────────────────────────────────────────
# Bật "App Password" trong Gmail: myaccount.google.com/apppasswords
SMTP_EMAIL=your_gmail@gmail.com
SMTP_PASSWORD=your_16char_app_password

# ── Frontend URL (cho email verification link) ─────────────────
FRONTEND_URL=http://localhost:5173
